# ── Database ──────────────────────────────────────────────────────────────
# Local dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (swap to Postgres/Supabase when you deploy a client):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── AI chatbot (required for the chat widget to work) ───────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ── Admin dashboard login ────────────────────────────────────────────────
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie. Generate one with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# ── Notifications (optional, needed for SMS/email confirmations) ────────
# Twilio (SMS confirmations + reminders)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend (email confirmations)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reservations@yourrestaurant.com"

# ── Per-client branding (edit this per install, see README) ─────────────
NEXT_PUBLIC_RESTAURANT_SLUG="demo-bar-grill"

# ── Stripe billing (Host Flow SaaS — optional until you're ready to charge) ─
# Without these set, Billing pages show "not configured" instead of erroring;
# checkout/portal/webhooks stay dormant until you add real test-mode keys.
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --print-secret` locally, or the webhook's settings
# page in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=""
# Used to build Checkout/Billing Portal redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Scheduled trial reconciliation (optional) ────────────────────────────
# Bearer token guarding POST/GET /api/cron/reconcile-billing — wire a
# scheduler (Vercel Cron, cron-job.org, etc.) to call it daily in production.
# Generate one with: openssl rand -hex 32
CRON_SECRET=""
